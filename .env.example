# GhostWatch Environment Configuration
# Copy this file to .env and fill in your credentials.
# The app works without IBM credentials (demo/local AI mode).

# ── IBM watsonx.ai Credentials (optional) ──────────────────────
# When set, GhostWatch uses IBM Granite models for generation and embeddings.
# When unset, GhostWatch runs in demo mode with local models.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── IBM Granite Guardian (optional) ────────────────────────────
# Enables the Granite Guardian safety layer for output screening.
GRANITE_GUARDIAN_API_KEY=
GRANITE_GUARDIAN_URL=
